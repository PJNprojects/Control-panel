# Python virtual environment created by Launch_ControlPanel.bat / .command
venv/
.venv/

# Self-contained portable Python interpreter downloaded by
# Launch_ControlPanel_Portable.command on macOS - 60-80MB binary distribution,
# does not belong in git; each machine builds (or copies) its own copy.
python-portable/

# Bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp

# Nothing in this project writes logs yet; this is here so that the first
# person who adds a capture-to-file feature does not commit a 200 MB session.
*.log
captures/
